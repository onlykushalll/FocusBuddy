rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getSession(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function isAdminOfSession(sessionId) {
      return isAuthenticated() && request.auth.uid == getSession(sessionId).adminDeviceId;
    }

    // Domain Validators
    function isValidSession(data) {
      return data.focusActive is bool &&
             data.adminDeviceId is string &&
             data.timestamp is timestamp &&
             data.timerSeconds is number &&
             data.status in ['lobby', 'countdown', 'active', 'paused', 'ended'] &&
             (!('startTime' in data) || data.startTime is timestamp || data.startTime == null) &&
             (!('endedAt' in data) || data.endedAt is timestamp || data.endedAt == null) &&
             (!('buddyIds' in data) || data.buddyIds is list) &&
             (!('pausedAt' in data) || data.pausedAt is timestamp || data.pausedAt == null) &&
             (!('accumulatedPausedSeconds' in data) || data.accumulatedPausedSeconds is number) &&
             (!('countdownEndsAt' in data) || data.countdownEndsAt is number || data.countdownEndsAt is timestamp || data.countdownEndsAt == null) &&
             (!('lastActive' in data) || data.lastActive is timestamp || data.lastActive == null);
    }

    function isValidBuddy(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.deviceId is string &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('whitelistedApps' in data) || data.whitelistedApps is list) &&
             (!('installedApps' in data) || data.installedApps is list) &&
             (!('requestStop' in data) || data.requestStop is bool) &&
             (!('requestPause' in data) || data.requestPause is bool) &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('faceDescriptor' in data) || data.faceDescriptor is string || data.faceDescriptor == null) &&
             (!('faceImage' in data) || data.faceImage is string || data.faceImage == null) &&
             (!('faceImages' in data) || data.faceImages is map) &&
             (!('nativeAlert' in data) || data.nativeAlert is string || data.nativeAlert == null) &&
             (!('nativeDeviceId' in data) || data.nativeDeviceId is string) &&
             (!('appIcons' in data) || data.appIcons is map) &&
             (!('pausedByFace' in data) || data.pausedByFace is bool) &&
             (!('lastFaceMatch' in data) || data.lastFaceMatch is bool) &&
             (!('securityThreats' in data) || data.securityThreats is map) &&
             (!('securityAlert' in data) || data.securityAlert is string) &&
             (!('rejectionReason' in data) || data.rejectionReason is string || data.rejectionReason == null) &&
             (!('requireFaceRereg' in data) || data.requireFaceRereg is bool) &&
             (!('reregCause' in data) || data.reregCause is string || data.reregCause == null);
    }

    match /sessions/{sessionId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (resource.data.adminDeviceId == request.auth.uid);
      
      allow create: if isAuthenticated() && 
                      isValidSession(request.resource.data) &&
                      request.resource.data.adminDeviceId == request.auth.uid &&
                      request.resource.data.status == 'lobby' &&
                      request.resource.data.focusActive == false;
                      
      allow update: if isAuthenticated() &&
                      (
                        // Admin: full update authority (validates complete schema)
                        (
                          resource.data.adminDeviceId == request.auth.uid &&
                          request.resource.data.adminDeviceId == resource.data.adminDeviceId &&
                          isValidSession(request.resource.data)
                        ) ||
                        // Buddy joining: only adds self to buddyIds (no validation on unmodified fields needed)
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buddyIds']) &&
                          request.resource.data.buddyIds.hasAny([request.auth.uid]) &&
                          request.resource.data.buddyIds.hasAll(resource.data.buddyIds)
                        ) ||
                        // Buddy auto-end: timer expired, can only set status to ended
                        (
                          resource.data.buddyIds.hasAny([request.auth.uid]) &&
                          resource.data.status in ['active', 'paused'] &&
                          request.resource.data.status == 'ended' &&
                          request.resource.data.focusActive == false &&
                          request.resource.data.adminDeviceId == resource.data.adminDeviceId &&
                          isValidSession(request.resource.data)
                        )
                      );

      // Sessions can NEVER be deleted (use status='ended' instead)
      allow delete: if false;

      match /buddies/{buddyId} {
        // Only admin and the buddy themselves can read buddy docs
        allow read: if isAdminOfSession(sessionId) || buddyId == request.auth.uid;
        
        allow create: if isAuthenticated() && 
                        buddyId == request.auth.uid &&
                        isValidBuddy(request.resource.data) &&
                        request.resource.data.deviceId == request.auth.uid &&
                        request.resource.data.status == 'pending';  // must start as pending
                        
        allow update: if isAuthenticated() &&
                        isValidBuddy(request.resource.data) &&
                        request.resource.data.deviceId == resource.data.deviceId &&
                        (
                          // Admin: full control
                          isAdminOfSession(sessionId) ||
                          // Buddy: ONLY allowed fields depending on session state
                          (
                            buddyId == request.auth.uid &&
                            request.resource.data.whitelistedApps == resource.data.whitelistedApps &&
                            request.resource.data.name == resource.data.name &&
                            request.resource.data.installedApps == resource.data.installedApps &&
                            (
                              // If session is in lobby, buddy can register face (or re-register if rejected)
                              (getSession(sessionId).status == 'lobby' &&
                               (
                                 // Simple registration (pending -> pending)
                                 (request.resource.data.status == resource.data.status &&
                                  request.resource.data.diff(resource.data).affectedKeys()
                                    .hasOnly(['faceDescriptor', 'faceImage', 'faceImages', 'isOnline'])) ||
                                 // Re-registration (rejected -> pending)
                                 (resource.data.status == 'rejected' &&
                                  request.resource.data.status == 'pending' &&
                                  request.resource.data.diff(resource.data).affectedKeys()
                                    .hasOnly(['faceDescriptor', 'faceImage', 'faceImages', 'status', 'rejectionReason', 'requireFaceRereg', 'reregCause', 'isOnline']))
                               )
                              ) ||
                              // If session is active/paused/countdown/ended, buddy can update verification, request flags, and security reports
                              (getSession(sessionId).status != 'lobby' &&
                               request.resource.data.status == resource.data.status &&
                               request.resource.data.faceDescriptor == resource.data.faceDescriptor &&
                               request.resource.data.faceImage == resource.data.faceImage &&
                               request.resource.data.faceImages == resource.data.faceImages &&
                               request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['pausedByFace', 'lastFaceMatch', 'requestStop', 'requestPause', 'isOnline', 'securityThreats', 'securityAlert', 'nativeAlert', 'appIcons', 'nativeDeviceId']))
                            )
                          ) ||
                          // Native device: only the specific fields FaceAnalyzerService/SecurityChecker
                          // write, linked via nativeDeviceId (set once by the buddy's own authenticated
                          // web session above, via getNativeDeviceId()). Narrower than the buddy's own
                          // field set — native has no business touching requestStop/appIcons/etc.
                          // Uses 'in' rather than direct access — nativeDeviceId won't exist on any
                          // buddy doc created before this field was added.
                          (
                            'nativeDeviceId' in resource.data &&
                            request.auth.uid == resource.data.nativeDeviceId &&
                            request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['nativeAlert', 'securityThreats', 'pausedByFace', 'lastFaceMatch'])
                          )
                        );
                        
        // Buddy can only self-delete while still in lobby (clean exit before
        // any session actually started) — cannot self-delete once active,
        // preserving the original anti-tampering intent below.
        allow delete: if isAdminOfSession(sessionId) ||
                        (buddyId == request.auth.uid && getSession(sessionId).status == 'lobby');
      }
    }
    
    // User profile for bootstrapping
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Connection test document
    match /test/connection {
      allow read: if isAuthenticated();
    }
  }
}
